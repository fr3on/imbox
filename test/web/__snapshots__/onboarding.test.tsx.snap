exports[`the wizard > at the appearance step 1`] = `"<div class="flex min-h-screen flex-col bg-background"><div class="shrink-0 pt-safe min-h-6"></div><div class="flex flex-1 items-start justify-center px-6 pb-10 pt-10 sm:items-center sm:pt-0"><div class="w-full max-w-[500px]"><header class="mb-8 text-center"><svg viewBox="-3 3 134.5 40" width="148" height="44" class="inline-block shrink-0 text-foreground select-none mx-auto" aria-label="imbox" role="img"><defs><clipPath id="imbox-wm-l"><rect x="61.5" y="0" width="28.4" height="46"></rect></clipPath><clipPath id="imbox-wm-r"><rect x="93.1" y="0" width="30" height="46"></rect></clipPath></defs><g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><circle cx="3" cy="9" r="3.1" fill="currentColor" stroke="none"></circle><path d="M3 20V40"></path><path d="M14 40V28a7 7 0 0 1 14 0V40M28 28a7 7 0 0 1 14 0V40"></path><path d="M52 6V40"></path><circle cx="62" cy="30" r="10"></circle><circle cx="91.5" cy="30" r="12.5" fill="currentColor" stroke="none" clip-path="url(#imbox-wm-l)"></circle><circle cx="91.5" cy="30" r="10" clip-path="url(#imbox-wm-r)"></circle><path d="M111 20L129 40M129 20L111 40"></path></g></svg><p class="mt-2 text-sm text-muted-foreground">A calmer inbox, on infrastructure you control.</p></header><div class=""><nav aria-label="Setup progress" class="mb-8"><ol class="flex items-center justify-between"><li class="flex flex-1 items-center last:flex-none"><button type="button" class="cursor-pointer hover:opacity-85 transition-opacity text-left" title="Go back to Provider"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors bg-foreground text-background"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ch