9-7-7 7-7"></path><path d="M19 12H5"></path></svg> Back to providers</button></div><div><h2 class="text-xl font-semibold tracking-tight">Connect your mailbox</h2><p class="mt-1 text-xs text-muted-foreground">Sign in to your mailbox. Imbox verifies credentials before saving.</p></div><div class="space-y-1.5"><label data-slot="label" class="flex items-center gap-2 font-medium select-none group-data-[disabled=true]:pointer-events-none group-data-[disabled=true]:opacity-50 peer-disabled:cursor-not-allowed peer-disabled:opacity-50 text-xs text-muted-foreground">Provider Preset</label><div class="flex flex-wrap gap-1.5"><button type="button" class="rounded-lg border px-2.5 py-1 text-xs transition-colors border-foreground bg-foreground text-background font-semibold">Custom / Domain</button><button type="button" class="rounded-lg border px-2.5 py-1 text-xs font-medium transition-colors border-border bg-card text-muted-foreground hover:border-foreground/30 hover:text-foreground">Gmail</button><button type="button" class="rounded-lg border px-2.5 py-1 text-xs font-medium transition-colors border-border bg-card text-muted-foreground hover:border-foreground/30 hover:text-foreground">Fastmail</button><button type="button" class="rounded-lg border px-2.5 py-1 text-xs font-medium transition-colors border-border bg-card text-muted-foreground hover:border-foreground/30 hover:text-foreground">iCloud</button><button type="button" class="rounded-lg border px-2.5 py-1 text-xs font-medium transition-colors border-border bg-card text-muted-foreground hover:border-foreground/30 hover:text-foreground">Zoho Mail</button><button type="button" class="rounded-lg border px-2.5 py-1 text-xs font-medium transition-colors border-border bg-card text-muted-foreground hover:border-foreground/30 hover:text-foreground">Migadu</button></div></div><p class="flex items-start gap-2 rounded-lg border border-border/60 bg-muted/30 p-2.5 text-xs text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb mt-0.5 size-3.5 shrink-0" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg> Enter your email. Server names will auto-fill as mail.&lt;your-domain&gt;.</p><form class="space-y-4"><div class="space-y-1.5"><label data-slot="label" class="flex items-center gap-2 font-medium select-none group-data-[disabled=true]:pointer-events-none group-data-[disabled=true]:opacity-50 peer-disabled:cursor-not-allowed peer-disabled:opacity-50 text-xs" for="onboarding-email">Email address</label><input type="email" data-slot="input" class="w-full min-w-0 rounded-md border border-transparent bg-input px-2.5 py-1 text-base transition-colors outline-none file:inline-flex file:h-6 file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:bg-background focus-visible:border-ring disabled:pointer-events-none disabled:cursor-not-allowed disabled:bg-input/50 disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 md:text-sm dark:bg-input dark:disabled:bg-input/80 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 h-10" id="onboarding-email" placeholder="you@example.com" required="" autofocus="" autoComplete="email" value=""/></div><div class="space-y-1.5"><label data-slot="label" class="flex items-center gap-2 font-medium select-none group-data-[disabled=true]:pointer-events-none group-data-[disabled=true]:opacity-50 peer-disabled:cursor-not-allowed peer-disabled:opacity-50 text-xs" for="onboarding-name">Display name <span class="text-muted-foreground font-normal">(optional)</span></label><input data-slot="input" class="w-full min-w-0 rounded-md border border-transparent bg-input px-2.5 py-1 text-base transition-colors outline-none file:inline-flex file:h-6 file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:bg-background focus-visible:border-ring disabled:pointer-events-none disabled:cursor-not-allowed disabled:bg-input/50 disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 md:text-sm dark:bg-input dark:disabled:bg-input/80 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 h-10" id="onboarding-name" placeholder="e.g. Maya" autoComplete="name" value=""/></div><div class="space-y-1.5"><div class="flex items-center justify-between"><label data-slot="label" class="flex items-center gap-2 font-medium select-none group-data-[disabled=true]:pointer-events-none group-data-[disabled=true]:opacity-50 peer-disabled:cursor-not-allowed peer-disabled:opacity-50 text-xs" for="onboarding-password">Password</label></div><div class="relative"><input type="password" data-slot="input" class="w-full min-w-0 rounded-md border border-transparent bg-input px-2.5 py-1 text-base transition-colors outline-none file:inline-flex file:h-6 file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:bg-background focus-visible:border-ring disabled:pointer-events-none disabled:cursor-not-allowed disabled:bg-input/50 disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 md:text-sm dark:bg-input dark:disabled:bg-input/80 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 h-10 pr-10" id="onboarding-password" placeholder="Enter password" required="" autoComplete="current-password" value=""/><button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground" aria-label="Show password"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye size-4" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></button></div></div><div class="pt-1"><div class="grid gap-1.5 text-left"><label for="onboarding-import" class="text-sm font-medium">Import recent mail</label><select id="onboarding-import" class="h-8 rounded-md bg-input px-2.5 text-sm outline-none focus:bg-background focus:ring-1 focus:ring-ring"><option value="0">Don&#x27;t import — only new mail</option><option value="25">My latest 25 messages</option><option value="50" selected="">My latest 50 messages</option><option value="100">My latest 100 messages</option><option value="200">My latest 200 messages</option></select><p class="text-xs text-muted-foreground">They arrive in the Screener like any first-time mail, a few every minute. Nothing older is fetched.</p></div></div><div data-state="closed" data-slot="collapsible" class="pt-1"><button type="button" class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground transition-colors" aria-expanded="false" data-state="closed" data-slot="collapsible-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-3.5 transition-transform" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg><span>Advanced Server Settings</span></button><div data-state="closed" id="radix-_R_1_" hidden="" data-slot="collapsible-content" class="space-y-3 pt-3"></div></div><button data-slot="button" data-variant="default" data-size="default" class="group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding text-sm whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 bg-primary text-primary-foreground hover:bg-primary/80 disabled:bg-muted disabled:text-muted-foreground disabled:opacity-100 gap-1.5 px-2.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 h-10 w-full font-medium" type="submit" disabled="">Connect Mailbox</button></form></div></div></div></div><p class="px-6 pb-6 text-center text-xs text-muted-foreground">Private mail, on your own server.</p></div>"`;

exports[`the wizard > greets nobody by name when there is none 1`] = `"<div class="flex min-h-screen flex-col bg-background"><div class="shrink-0 pt-safe min-h-6"></div><div class="flex flex-1 items-start justify-center px-6 pb-10 pt-10 sm:items-center sm:pt-0"><div class="w-full max-w-[500px]"><header class="mb-8 text-center"><svg viewBox="-3 3 134.5 40" width="148" height="44" class="inline-block shrink-0 text-foreground select-none mx-auto" aria-label="imbox" role="img"><defs><clipPath id="imbox-wm-l"><rect x="61.5" y="0" width="28.4" height="46"></rect></clipPath><clipPath id="imbox-wm-r"><rect x="93.1" y="0" width="30" height="46"></rect></clipPath></defs><g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><circle cx="3" cy="9" r="3.1" fill="currentColor" stroke="none"></circle><path d="M3 20V40"></path><path d="M14 40V28a7 7 0 0 1 14 0V40M28 28a7 7 0 0 1 14 0V40"></path><path d="M52 6V40"></path><circle cx="62" cy="30" r="10"></circle><circle cx="91.5" cy="30" r="12.5" fill="currentColor" stroke="none" clip-path="url(#imbox-wm-l)"></circle><circle cx="91.5" cy="30" r="10" clip-path="url(#imbox-wm-r)"></circle><path d="M111 20L129 40M129 20L111 40"></path></g></svg><p class="mt-2 text-sm text-muted-foreground">A calmer inbox, on infrastructure you control.</p></header><div class=""><nav aria-label="Setup progress" class="mb-8"><ol class="flex items-center justify-between"><li class="flex flex-1 items-center last:flex-none"><button type="button" class="cursor-pointer hover:opacity-85 transition-opacity text-left" title="Go back to Provider"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors bg-foreground text-background"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-3.5 stroke-[3]" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="text-xs font-medium tracking-tight text-muted-foreground">Provider</span></div></button><div class="mx-2 sm:mx-3 h-[1px] flex-1 transition-colors bg-foreground"></div></li><li class="flex flex-1 items-center last:flex-none"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors bg-foreground text-background"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-3.5 stroke-[3]" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="text-xs font-medium tracking-tight text-muted-foreground">Setup</span></div><div class="mx-2 sm:mx-3 h-[1px] flex-1 transition-colors bg-foreground"></div></li><li class="flex flex-1 items-center last:flex-none"><button type="button" class="cursor-pointer hover:opacity-85 transition-opacity text-left" title="Go back to Appearance"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors bg-foreground text-background"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-3.5 stroke-[3]" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="text-xs font-medium tracking-tight text-muted-foreground">Appearance</span></div></button><div class="mx-2 sm:mx-3 h-[1px] flex-1 transition-colors bg-foreground"></div></li><li class="flex flex-1 items-center last:flex-none"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors border-2 border-foreground bg-background text-foreground">4</span><span class="text-xs tracking-tight text-foreground font-semibold">Ready</span></div></li></ol></nav><div class="space-y-6"><div class="flex items-center gap-3"><div class="flex size-11 items-center justify-center rounded-full bg-foreground text-background"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-6 stroke-[2.5]" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></div><div><h1 class="text-2xl font-semibold tracking-tight">You&#x27;re all set!</h1><p class="text-xs text-muted-foreground">Your workspace and preferences are configured.</p></div></div><div class="rounded-xl border border-border bg-card p-3.5 space-y-2.5"><div class="flex items-center justify-between text-xs"><span class="text-muted-foreground flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-palette size-3.5 text-muted-foreground" aria-hidden="true"><path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"></path><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle></svg> Appearance &amp; Style</span><span class="font-medium text-foreground">Full · <span class="capitalize">light</span></span></div></div><div class="space-y-2.5"><div class="flex items-start gap-3.5 rounded-xl border border-border/70 bg-card/60 p-3.5 text-left"><div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4"><circle cx="12" cy="12" r="8" stroke-dasharray="2.2 3.1"></circle></svg></div><div><h4 class="text-xs font-semibold text-foreground">First-time senders wait in the Screener</h4><p class="mt-0.5 text-xs text-muted-foreground leading-normal">You choose who enters your Imbox. When someone new writes, you give a quick yes or no.</p></div></div><div class="flex items-start gap-3.5 rounded-xl border border-border/70 bg-card/60 p-3.5 text-left"><div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-newspaper size-4" aria-hidden="true"><path d="M15 18h-5"></path><path d="M18 14h-8"></path><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2"></path><rect width="8" height="4" x="10" y="6" rx="1"></rect></svg></div><div><h4 class="text-xs font-semibold text-foreground">Receipts and newsletters sort themselves</h4><p class="mt-0.5 text-xs text-muted-foreground leading-normal">Feed keeps automated mail out of the way until you want to browse.</p></div></div><div class="flex items-start gap-3.5 rounded-xl border border-border/70 bg-card/60 p-3.5 text-left"><div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4"><path d="M10.5 4a8 8 0 0 0 0 16z" fill="currentColor" stroke="none"></path><path d="M13.5 4a8 8 0 0 1 0 16z"></path></svg></div><div><h4 class="text-xs font-semibold text-foreground">Only approved conversations reach your Imbox</h4><p class="mt-0.5 text-xs text-muted-foreground leading-normal">A calm, quiet inbox on infrastructure you control.</p></div></div></div><div class="pt-2 flex flex-col sm:flex-row items-center gap-2.5"><button data-slot="button" data-variant="default" data-size="lg" class="group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding text-sm whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 bg-primary text-primary-foreground hover:bg-primary/80 disabled:bg-muted disabled:text-muted-foreground disabled:opacity-100 gap-1.5 px-2.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 w-full sm:flex-1 h-11 font-medium cursor-pointer">Connect a mailbox <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right size-4 ml-1.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button></div></div></div></div></div><p class="px-6 pb-6 text-center text-xs text-muted-foreground">Private mail, on your own server.</p></div>"`;

exports[`the wizard > offers Microsoft and an app password for Gmail where no Google sign-in is set up 1`] = `"<div class="flex min-h-screen flex-col bg-background"><div class="shrink-0 pt-safe min-h-6"></div><div class="flex flex-1 items-start justify-center px-6 pb-10 pt-10 sm:items-center sm:pt-0"><div class="w-full max-w-[500px]"><header class="mb-8 text-center"><svg viewBox="-3 3 134.5 40" width="148" height="44" class="inline-block shrink-0 text-foreground select-none mx-auto" aria-label="imbox" role="img"><defs><clipPath id="imbox-wm-l"><rect x="61.5" y="0" width="28.4" height="46"></rect></clipPath><clipPath id="imbox-wm-r"><rect x="93.1" y="0" width="30" height="46"></rect></clipPath></defs><g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><circle cx="3" cy="9" r="3.1" fill="currentColor" stroke="none"></circle><path d="M3 20V40"></path><path d="M14 40V28a7 7 0 0 1 14 0V40M28 28a7 7 0 0 1 14 0V40"></path><path d="M52 6V40"></path><circle cx="62" cy="30" r="10"></circle><circle cx="91.5" cy="30" r="12.5" fill="currentColor" stroke="none" clip-path="url(#imbox-wm-l)"></circle><circle cx="91.5" cy="30" r="10" clip-path="url(#imbox-wm-r)"></circle><path d="M111 20L129 40M129 20L111 40"></path></g></svg><p class="mt-2 text-sm text-muted-foreground">A calmer inbox, on infrastructure you control.</p></header><div class=""><nav aria-label="Setup progress" class="mb-8"><ol class="flex items-center justify-between"><li class="flex flex-1 items-center last:flex-none"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors border-2 border-foreground bg-background text-foreground">1</span><span class="text-xs tracking-tight text-foreground font-semibold">Provider</span></div><div class="mx-2 sm:mx-3 h-[1px] flex-1 transition-colors bg-border"></div></li><li class="flex flex-1 items-center last:flex-none"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors border border-border text-muted-foreground">2</span><span class="text-xs font-medium tracking-tight text-muted-foreground">Setup</span></div><div class="mx-2 sm:mx-3 h-[1px] flex-1 transition-colors bg-border"></div></li><li class="flex flex-1 items-center last:flex-none"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors border border-border text-muted-foreground">3</span><span class="text-xs font-medium tracking-tight text-muted-foreground">Appearance</span></div><div class="mx-2 sm:mx-3 h-[1px] flex-1 transition-colors bg-border"></div></li><li class="flex flex-1 items-center last:flex-none"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors border border-border text-muted-foreground">4</span><span class="text-xs font-medium tracking-tight text-muted-foreground">Ready</span></div></li></ol></nav><div class="space-y-6"><div><h1 class="text-[26px] font-semibold leading-8 tracking-[-0.02em]">Let&#x27;s connect your mail, Maya</h1><p class="mt-2 text-sm text-muted-foreground leading-relaxed">Choose your mail service to begin. Imbox starts fresh from this moment — past mail is only imported if you choose.</p></div><div class="grid gap-3"><button type="button" class="group relative flex w-full items-start gap-4 rounded-xl border border-border bg-card p-4 text-left shadow-xs transition-all hover:border-foreground/40 hover:bg-muted/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground transition-colors group-hover:bg-foreground group-hover:text-background"><svg xmlns="http://www.w3.o