exports[`the wizard > at the choose step 1`] = `"<div class="flex min-h-screen flex-col bg-background"><div class="shrink-0 pt-safe min-h-6"></div><div class="flex flex-1 items-start justify-center px-6 pb-10 pt-10 sm:items-center sm:pt-0"><div class="w-full max-w-[500px]"><header class="mb-8 text-center"><svg viewBox="-3 3 134.5 40" width="148" height="44" class="inline-block shrink-0 text-foreground select-none mx-auto" aria-label="imbox" role="img"><defs><clipPath id="imbox-wm-l"><rect x="61.5" y="0" width="28.4" height="46"></rect></clipPath><clipPath id="imbox-wm-r"><rect x="93.1" y="0" width="30" height="46"></rect></clipPath></defs><g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><circle cx="3" cy="9" r="3.1" fill="currentColor" stroke="none"></circle><path d="M3 20V40"></path><path d="M14 40V28a7 7 0 0 1 14 0V40M28 28a7 7 0 0 1 14 0V40"></path><path d="M52 6V40"></path><circle cx="62" cy="30" r="10"></circle><circle cx="91.5" cy="30" r="12.5" fill="currentColor" stroke="none" clip-path="url(#imbox-wm-l)"></circle><circle cx="91.5" cy="30" r="10" clip-path="url(#imbox-wm-r)"></circle><path d="M111 20L129 40M129 20L111 40"></path></g></svg><p class="mt-2 text-sm text-muted-foreground">A calmer inbox, on infrastructure you control.</p></header><div class=""><nav aria-label="Setup progress" class="mb-8"><ol class="flex items-center justify-between"><li class="flex flex-1 items-center last:flex-none"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors border-2 border-foreground bg-background text-foreground">1</span><span class="text-xs tracking-tight text-foreground font-semibold">Provider</span></div><div class="mx-2 sm:mx-3 h-[1px] flex-1 transition-colors bg-border"></div></li><li class="flex flex-1 items-center last:flex-none"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors border border-border text-muted-foreground">2</span><span class="text-xs font-medium tracking-tight text-muted-foreground">Setup</span></div><div class="mx-2 sm:mx-3 h-[1px] flex-1 transition-colors bg-border"></div></li><li class="flex flex-1 items-center last:flex-none"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors border border-border text-muted-foreground">3</span><span class="text-xs font-medium tracking-tight text-muted-foreground">Appearance</span></div><div class="mx-2 sm:mx-3 h-[1px] flex-1 transition-colors bg-border"></div></li><li class="flex flex-1 items-center last:flex-none"><div class="flex items-center gap-1.5 sm:gap-2"><span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold transition-colors border border-border text-muted-foreground">4</span><span class="text-xs font-medium tracking-tight text-muted-foreground">Ready</span></div></li></ol></nav><div class="space-y-6"><div><h1 class="text-[26px] font-semibold leading-8 tracking-[-0.02em]">Let&#x27;s connect your mail, Maya</h1><p class="mt-2 text-sm text-muted-foreground leading-relaxed">Choose your mail service to begin. Imbox starts fresh from this moment — past mail is only imported if you choose.</p></div><div class="grid gap-3"><button type="button" class="group relative flex w-full items-start gap-4 rounded-xl border border-border bg-card p-4 text-left shadow-xs transition-all hover:border-foreground/40 hover:bg-muted/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground transition-colors group-hover:bg-foreground group-hover:text-background"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="