  .strip-details{width:100%;margin-top:6px;font-size:11.5px;color:rgba(55,53,47,.65);}
  .strip-details summary{cursor:pointer;color:rgba(55,53,47,.65);outline:none;}
  .strip-details summary:hover{color:#37352f;}

  /* Caution &amp; sensitivity banners */
  .caution-banner-subtle{border:1px solid rgba(239,68,68,.25) !important;border-left:3px solid #ef4444 !important;background:rgba(239,68,68,.05) !important;padding:6px 10px !important;border-radius:6px !important;font-size:11.5px !important;line-height:1.4 !important;color:rgba(55,53,47,.65) !important;margin:12px 0 !important;}
  .caution-banner-subtle *{font-size:11.5px !important;font-weight:normal !important;color:inherit !important;}
  .caution-banner-subtle b,.caution-banner-subtle strong{font-weight:600 !important;color:#37352f !important;}
  .email-sensitivity-label{display:inline-block !important;font-size:11px !important;font-weight:500 !important;color:rgba(55,53,47,.65) !important;background:rgba(55,53,47,.06) !important;border:1px solid rgba(55,53,47,.09) !important;padding:1px 8px !important;border-radius:999px !important;margin-bottom:8px !important;letter-spacing:normal !important;}

  /* Outlook &amp; divider normalization */
  hr{border:0;border-top:1px solid rgba(55,53,47,.09);margin:1.25rem 0;opacity:.5;}
  p.MsoNormal,li.MsoNormal,div.MsoNormal{margin-bottom:.5em;}
  p:empty, p.MsoNormal:empty{margin:0 !important;padding:0 !important;min-height:0 !important;}

  /* Option A: Inline Quote Fold */
  .inline-fold-bar{position:relative;display:flex;align-items:center;justify-content:center;margin:18px 0 12px;}
  .inline-fold-bar::before{content:&quot;&quot;;position:absolute;inset-inline:0;top:50%;border-top:1px dashed rgba(55,53,47,.09);z-index:1;}
  .inline-fold-btn{position:relative;z-index:2;background:#ffffff;border:1px solid rgba(55,53,47,.09);border-radius:999px;padding:3px 12px;font-size:11.5px;color:rgba(55,53,47,.65);display:inline-flex;align-items:center;gap:6px;cursor:pointer;font-family:inherit;transition:all .15s ease;}
  .inline-fold-btn:hover{color:#37352f;border-color:#37352f;background:rgba(55,53,47,0.03);}
  .inline-fold-btn .fold-chevron{width:13px;height:13px;stroke-width:2;stroke:currentColor;fill:none;transition:transform .15s ease;}
  .inline-fold-btn.is-open .fold-chevron{transform:rotate(180deg);}
  .inline-fold-btn .fold-badge{font-family:&quot;Geist Mono Variable&quot;,&quot;Geist Mono&quot;,ui-monospace,Menlo,monospace;font-size:10.5px;background:rgba(55,53,47,0.03);border:1px solid rgba(55,53,47,.09);padding:0 6px;border-radius:999px;color:rgba(55,53,47,.65);}
  
  .outlook-quoted, blockquote, .gmail_quote{border-left:2px solid rgba(55,53,47,.09) !important;padding-left:14px !important;margin-left:4px !important;margin-top:8px !important;}
  .outlook-quoted.imbox-quoted-hidden, blockquote.imbox-quoted-hidden, .gmail_quote.imbox-quoted-hidden{display:none !important;}
&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;p&gt;Message number 5.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;" style="height:48px;color-scheme:normal"></iframe></div><div class="absolute inset-x-0 top-0 space-y-2 pt-1"><div data-slot="skeleton" class="animate-pulse rounded-md bg-muted h-3 w-4/5"></div><div data-slot="skeleton" class="animate-pulse rounded-md bg-muted h-3 w-3/5"></div></div></div></div></article></div></div>"
`;

