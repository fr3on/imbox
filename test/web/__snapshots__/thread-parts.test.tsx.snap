"group/button inline-flex shrink-0 items-center justify-center border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-6 rounded-[min(var(--radius-md),10px)] in-data-[slot=button-group]:rounded-lg [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-3 text-muted-foreground" aria-label="More" type="button" id="radix-_R_2_" aria-haspopup="menu" aria-expanded="false" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ellipsis lucide-more-horizontal" aria-hidden="true"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg></button></div></header><div class="pl-[34px] pt-3"><div class="relative"><div class="relative overflow-hidden opacity-0" style="min-height:48px"><iframe title="message" class="email-body" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" srcDoc="&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset=&quot;utf-8&quot;&gt;&lt;meta http-equiv=&quot;Content-Security-Policy&quot; content=&quot;default-src &#x27;none&#x27;; style-src &#x27;unsafe-inline&#x27;; font-src data:; base-uri &#x27;none&#x27;; form-action &#x27;none&#x27;; img-src data: blob: &#x27;self&#x27;&quot;&gt;&lt;meta name=&quot;referrer&quot; content=&quot;no-referrer&quot;&gt;&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width&quot;&gt;&lt;style&gt;
  html{color-scheme:light;}
  html,body{margin:0;padding:0;background:transparent;}
  body{display:flow-root;font-family:&quot;Geist Variable&quot;,Geist,system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.6;color:#37352f;word-wrap:break-word;overflow-wrap:anywhere;}
  img{max-width:100% !important;height:auto;}
  table{max-width:100% !important;}
  a{color:#37352f;text-decoration:underline;text-underline-offset:2px;}
  blockquote{border-left:2px solid rgba(55,53,47,.09);margin:.5em 0;padding-left:1em;color:rgba(55,53,47,.65);}
  pre{white-space:pre-wrap;font-family:&quot;Geist Mono Variable&quot;,&quot;Geist Mono&quot;,ui-monospace,Menlo,monospace;font-size:12.5px;}
  ::selection{background:#37352f;color:#ffffff;}
  .imbox-quoted-hidden{display:none !important;}

  /* Option B: Quiet strip for conference meetings */
  .strip-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 13px;border:1px solid rgba(55,53,47,.09);border-radius:8px;background:rgba(55,53,47,0.03);margin:16px 0;box-sizing:border-box;flex-wrap:wrap;}
  .strip-left{display:flex;align-items:center;gap:10px;font-size:13px;min-width:0;flex-wrap:wrap;}
  .strip-title{font-weight:600;color:#37352f;letter-spacing:-0.01em;}
  .strip-info{display:flex;align-items:center;gap:10px;color:rgba(55,53,47,.65);font-size:12px;font-family:&quot;Geist Mono Variable&quot;,&quot;Geist Mono&quot;,ui-monospace,Menlo,monospace;}
  .strip-copy-btn{border:1px solid rgba(55,53,47,.09);background:transparent;color:rgba(55,53,47,.65);font-size:10.5px;padding:1px 6px;border-radius:4px;cursor:pointer;font-family:inherit;}
  .strip-copy-btn:hover{color:#37352f;border-color:#37352f;}
  .strip-join{border:1px solid #37352f;background:#37352f;color:#ffffff !important;padding:5px 13px;border-radius:6px;font-size:12px;font-weight:500;text-decoration:none !important;white-space:nowrap;cursor:pointer;flex-shrink:0;transition:opacity .15s ease;}
  .strip-join:hover{opacity:.88;}
  .strip-details{width:100%;margin-top:6px;font-size:11.5px;color:rgba(55,53,47,.65);}
  .strip-details summary{cursor:pointer;color:rgba(55,53,47,.65);outline:none;}
  .strip-details summary:hover{color:#37352f;}

  /* Caution &amp; sensitivity banners */
  .caution-banner-subtle{border:1px solid rgba(239,68,68,.25) !important;border-left:3px solid #ef4444 !important;background:rgba(239,68,68,.05) !important;padding:6px 10px !important;border-radius:6px !important;font-size:11.5px !important;line-height:1.4 !important;color:rgba(55,53,47,.65) !important;margin:12px 0 !important;}
  .caution-banner-subtle *{font-size:11.5px !important;font-weight:normal !important;color:inherit !important;}
  .caution-banner-subtle b,.caution-banner-subtle strong{font-weight:600 !important;color:#37352f !important;}
  .email-sensitivity-label{display:inline-block !important;font-size:11px !important;font-weight:500 !important;color:rgba(55,53,47,.65) !important;background:rgba(55,53,47,.06) !important;border:1px solid rgba(55,53,47,.09) !important;padding:1px 8px !important;border-radius:999px !important;margin-bottom:8px !important;letter-spacing:normal !important;}

  /* Outlook &amp; divider normalization */
  hr{border:0;border-top:1px solid rgba(55,53,47,.09);margin:1.25rem 0;opacity:.5;}
  p.MsoNormal,li.MsoNormal,div.MsoNormal{margin-bottom:.5em;}
  p:empty, p.MsoNormal:empty{margin:0 !important;padding:0 !important;min-height:0 !important;}

  /* Option A: Inline Quote Fold */
  .inline-fold-bar{position:relative;display:flex;align-items:center;justify-content:center;margin:18px 0 12px;}
  .inline-fold-bar::before{content:&quot;&quot;;position:absolute;inset-inline:0;top:50%;border-top:1px dashed rgba(55,53,47,.09);z-index:1;}
  .inline-fold-btn{position:relative;z-index:2;background:#ffffff;border:1px solid rgba(55,53,47,.09);border-radius:999px;padding:3px 12px;font-size:11.5px;color:rgba(55,53,47,.65);display:inline-flex;align-items:center;gap:6px;cursor:pointer;font-family:inherit;transition:all .15s ease;}
  .inline-fold-btn:hover{color:#37352f;border-color:#37352f;background:rgba(55,53,47,0.03);}
  .inline-fold-btn .fold-chevron{width:13px;height:13px;stroke-width:2;stroke:currentColor;fill:none;transition:transform .15s ease;}
  .inline-fold-btn.is-open .fold-chevron{transform:rotate(180deg);}
  .inline-fold-btn .fold-badge{font-family:&quot;Geist Mono Variable&quot;,&quot;Geist Mono&quot;,ui-monospace,Menlo,monospace;font-size:10.5px;background:rgba(55,53,47,0.03);border:1px solid rgba(55,53,47,.09);padding:0 6px;border-radius:999px;color:rgba(55,53,47,.65);}
  
  .outlook-quoted, blockquote, .gmail_quote{border-left:2px solid rgba(55,53,47,.09) !important;padding-left:14px !important;margin-left:4px !important;margin-top:8px !important;}
  .outlook-quoted.imbox-quoted-hidden, blockquote.imbox-quoted-hidden, .gmail_quote.imbox-quoted-hidden{display:none !important;}
&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;p&gt;Message number 5.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;" style="height:48px;color-scheme:normal"></iframe></div><div class="absolute inset-x-0 top-0 space-y-2 pt-1"><div data-slot="skeleton" class="animate-pulse rounded-md bg-muted h-3 w-4/5"></div><div data-slot="skeleton" class="animate-pulse rounded-md bg-muted h-3 w-3/5"></div></div></div></div></article></div></div>"
`;

