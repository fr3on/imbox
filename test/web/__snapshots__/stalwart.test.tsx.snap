exports[`the panels > import choice 1`] = `"<div class="grid gap-1.5 text-left"><label for="import-recent" class="text-sm font-medium">Import recent mail</label><select id="import-recent" class="h-8 rounded-md bg-input px-2.5 text-sm outline-none focus:bg-background focus:ring-1 focus:ring-ring"><option value="0">Don&#x27;t import — only new mail</option><option value="25">My latest 25 messages</option><option value="50" selected="">My latest 50 messages</option><option value="100">My latest 100 messages</option><option value="200">My latest 200 messages</option></select><p class="text-xs text-muted-foreground">They arrive in the Screener like any first-time mail, a few every minute. Nothing older is fetched.</p></div>"`;

