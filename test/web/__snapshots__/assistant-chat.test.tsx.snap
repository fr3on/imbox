exports[`the assistant on each page > docked with menu actions and threads attached 1`] = `"<div class="flex flex-col min-h-0 h-full"><div class="flex-1 min-h-0 overflow-y-auto px-4"><div class="py-8"><div class="text-center mb-5 px-4"><h1 class="text-xl sm:text-2xl font-semibold tracking-tight text-foreground">How can I help you today?</h1><p class="text-sm text-muted-foreground mt-2">Read, search and organise your mail, screen senders, or draft a reply.</p></div><div class="flex flex-wrap justify-center gap-2"><button type="button" class="inline-flex items-center h-9 px-3.5 rounded-full border border-border/70 text-[13px] text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer">What is the deadline?</button><button type="button" class="inline-flex items-center h-9 px-3.5 rounded-full border border-border/70 text-[13px] text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer">Catch me up</button><button type="button" class="inline-flex items-center h-9 px-3.5 rounded-full border border-border/70 text-[13px] text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer">Draft a reply</button><button type="button" class="inline-flex items-center h-9 px-3.5 rounded-full border border-border/70 text-[13px] text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer">Reply briefly</button><button type="button" class="inline-flex items-center h-9 px-3.5 rounded-full border border-border/70 text-[13px] text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer">Summarize</button></div></div><div class="w-full"><div class="py-4 space-y-5"><div></div></div></div></div><div class="shrink-0 w-full"><form class="w-full px-3 pb-3 pt-1"><div class="rounded-[20px] border border-border bg-background px-3.5 pb-2.5 pt-3 shadow-sm transition-colors focus-within:border-foreground/30"><div class="mb-2 flex flex-wrap gap-1.5"><span class="inline-flex h-7 max-w-[280px] items-center gap-1.5 rounded-lg bg-muted/70 pl-2 pr-1 text-[12.5px]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-paperclip size-3 shrink-0 text-muted-foreground" aria-hidden="true"><path d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551"></path></svg><span class="truncate">Studio plan</span><button type="button" aria-label="Remove context" class="flex size-5 items-center justify-center rounded-md text-muted-foreground hover:bg-background hover:text-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x size-3" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></span><span class="inline-flex h-7 max-w-[280px] items-center gap-1.5 rounded-lg bg-muted/70 pl-2 pr-1 text-[12.5px]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-paperclip size-3 shrink-0 text-muted-foreground" aria-hidden="true"><path d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551"></path></svg><span class="truncate">(no subject)</span><button type="button" aria-label="Remove context" class="flex size-5 items