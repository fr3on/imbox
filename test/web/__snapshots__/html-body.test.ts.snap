  .caution-banner-subtle b,.caution-banner-subtle strong{font-weight:600 !important;color:#111111 !important;}
  .email-sensitivity-label{display:inline-block !important;font-size:11px !important;font-weight:500 !important;color:#666666 !important;background:rgba(55,53,47,.06) !important;border:1px solid #dddddd !important;padding:1px 8px !important;border-radius:999px !important;margin-bottom:8px !important;letter-spacing:normal !important;}

  /* Outlook & divider normalization */
  hr{border:0;border-top:1px solid #dddddd;margin:1.25rem 0;opacity:.5;}
  p.MsoNormal,li.MsoNormal,div.MsoNormal{margin-bottom:.5em;}
  p:empty, p.MsoNormal:empty{margin:0 !important;padding:0 !important;min-height:0 !important;}

  /* Option A: Inline Quote Fold */
  .inline-fold-bar{position:relative;display:flex;align-items:center;justify-content:center;margin:18px 0 12px;}
  .inline-fold-bar::before{content:"";position:absolute;inset-inline:0;top:50%;border-top:1px dashed #dddddd;z-index:1;}
  .inline-fold-btn{position:relative;z-index:2;background:#fefefe;border:1px solid #dddddd;border-radius:999px;padding:3px 12px;font-size:11.5px;color:#666666;display:inline-flex;align-items:center;gap:6px;cursor:pointer;font-family:inherit;transition:all .15s ease;}
  .inline-fold-btn:hover{color:#111111;border-color:#111111;background:rgba(55,53,47,0.03);}
  .inline-fold-btn .fold-chevron{width:13px;height:13px;stroke-width:2;stroke:currentColor;fill:none;transition:transform .15s ease;}
  .inline-fold-btn.is-open .fold-chevron{transform:rotate(180deg);}
  .inline-fold-btn .fold-badge{font-family:"Geist Mono Variable","Geist Mono",ui-monospace,Menlo,monospace;font-size:10.5px;background:rgba(55,53,47,0.03);border:1px solid #dddddd;padding:0 6px;border-radius:999px;color:#666666;}
  
  .outlook-quoted, blockquote, .gmail_quote{border-left:2px solid #dddddd !important;padding-left:14px !important;margin-left:4px !important;margin-top:8px !important;}
  .outlook-quoted.imbox-quoted-hidden, blockquote.imbox-quoted-hidden, .gmail_quote.imbox-quoted-hidden{display:none !important;}
