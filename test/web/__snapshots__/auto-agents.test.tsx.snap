exports[`Editor dialog > renders dialog for creating new agent with instructions templates 1`] = `"<div data-slot="dialog-content" class="max-h-[90vh] overflow-y-auto sm:max-w-4xl"><div data-slot="dialog-header"><h2 data-slot="dialog-title">New agent</h2><p data-slot="dialog-description">It reads new mail in the mailboxes you choose and follows your instructions. It only ever replies to the person who wrote.</p></div><div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)]"><div class="min-w-0 space-y-5 md:border-r md:border-border md:pr-6"><div class="space-y-1.5"><label for="ag-name" class="text-sm font-medium">Name</label><input data-slot="input" class="h-8 w-full min-w-0 rounded-md border border-transparent bg-input px-2.5 py-1 text-base transition-colors outline-none file:inline-flex file:h-6 file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:bg-background focus-visible:border-ring disabled:pointer-events-none disabled:cursor-not-allowed disabled:bg-input/50 disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 md:text-sm dark:bg-input dark:disabled:bg-input/80 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40" id="ag-name" placeholder="Scheduling assistant" maxLength="60" value=""/></div><div class="space-y-1.5"><div class="text-sm font-medium">Mailboxes it watches</div><div class="flex max-h-36 flex-wrap gap-1.5 overflow-y-auto"><button type="button" aria-pressed="false" class="max-w-full truncate rounded-full border px-2.5 py-1 text-xs transition-colors border-border text-muted-foreground hover:bg-muted/60 hover:text-foreground">maya@gmail.test</button><button type="button" aria-pressed="false" class="max-w-full truncate rounded-full border px-2.5 py-1 text-xs transition-colors border-border text-muted-foreground hover:bg-muted/60 hover:text-foreground">maya@chen.studio</button><button type="button" aria-pressed="false" class="max-w-full truncate rounded-full border px-2.5 py-1 text-xs transition-colors border-border text-muted-foreground hover:bg-muted/60 hover:text-foreground">maya@outlook.test</button><button type="button" aria-pressed="false" class="max-w-full truncate rounded-full border px-2.5 py-1 text-xs transition-colors border-border text-muted-foreground hover:bg-muted/60 hover:text-foreground">hello@chen.studio</button></div></div><div class="space-y-2"><div class="text-sm font-medium">What it does with a reply</div><label class="flex cursor-pointer items-start gap-3 rounded-lg border p-3 transition-colors border-foreground"><input type="radio" class="mt-1 accent-foreground" name="ag-mode" checked=""/><span><span class="block text-sm font-medium">Write a draft for me to review</span><span class="block text-xs text-muted-foreground">Recommended. The reply waits in Drafts and in your notifications until you send it.</span></span></label><label class="flex cursor-pointer items-start gap-3 rounded-lg border p-3 transition-colors border-border hover:bg-muted/40"><input type="radio" class="mt-1 accent-foreground" name="ag-mode"/><span><span class="block text-sm font-medium">Send replies by itself</span><span class="block text-xs text-muted-foreground">Replies go out from your address without you seeing them first, marked as automatic.</span></span></label></div><div class="space-y-3 rounded-lg border border-border p-3"><div class="text-sm font-medium">Which mail</div><label class="flex items-center justify-between gap-3 text-[13px]"><span>Only people I have screened in</span><button type="button" role="switch" aria-checked="true" data-state="checked" value="on" data-slot="switch" data-size="default" class="peer group/switch relative inline-flex shrink-0 items-center rounded-full border border-transparent transition-all outline-none group-has-focus-visible/field-label:border-transparent group-has-focus-visible/field-label:ring-0 after:absolute 