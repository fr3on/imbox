exports[`the request function > sends the scope, the browser's time zone and cookies, a JSON body only when there is one, and the query string helper skips empty values 1`] = `
[
  [
    "GET",
    "/api/x",
    {
      "X-Account-Id": "all",
      "X-Timezone": "Africa/Cairo",
    },
    undefined,
    "include",
  ],
  [
    "POST",
    "/api/y",
    {
      "Content-Type": "application/json",
      "X-Account-Id": "acc-1",
      "X-Timezone": "Africa/Cairo",
    },
    "{"a":1}",
    "include",
  ],
  [
    "DELETE",
    "/api/z",
    {
      "X-Account-Id": "acc-1",
      "X-Timezone": "Africa/Cairo",
    },
    undefined,
    "include",
  ],
]
`;

