exports[`the Settings page > shows the security tab 1`] = `"<div class="max-w-5xl mx-auto w-full px-2 sm:px-4 py-2"><header class="mb-8 pb-5 border-b border-border/60"><h1 class="text-2xl sm:text-[28px] font-bold tracking-tight text-foreground">Settings</h1><p class="text-xs sm:text-[13px] text-muted-foreground mt-1">Manage your identity, mailboxes, security, and preferences.</p></header><div class="flex flex-col md:flex-row gap-4 md:gap-6 lg:gap-8 items-start"><aside class="w-full min-w-0 shrink-0 md:w-auto md:sticky md:top-24 md:border-r md:border-border/60 md:pr-3 lg:pr-5"><nav aria-label="Settings" class="flex gap-1.5 overflow-x-auto pb-1 [scrollbar-width:none] [&amp;::-webkit-scrollbar]:hidden md:w-11 md:flex-col md:gap-0.5 md:overflow-visible md:pb-0 lg:w-40"><button type="button" aria-label="Profile" class="group flex shrink-0 items-center gap-2.5 whitespace-nowrap text-[13.5px] outline-none transition-colors focus-visible:ring-1 focus-visible:ring-ring rounded-full border px-3 py-1.5 md:justify-center md:rounded-lg md:border-transparent md:px-0 md:py-2 lg:justify-start lg:px-2.5 border-border text-muted-foreground hover:text-foreground md:hover:bg-muted/40" data-state="closed" data-slot="tooltip-trigger"><span class="flex size-4 shrink-0 items-center justify-center [&amp;&gt;svg]:size-4 max-md:hidden"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.2" r="3.4"></circle><path d="M5 20a7 7 0 0 1 14 0"></path></svg></span><span class="truncate md:sr-only lg:not-sr-only">Profile</span></button><button type="button" aria-label="Security" aria-current="page" class="group flex shrink-0 items-center gap-2.5 whitespace-nowrap text-[13.5px] outline-none transition-colors focus-visible:ring-1 focus-visible:ring-ring rounded-full border px-3 py-1.5 md:justify-center md:rounded-lg md:border-transparent md:px-0 md:py-2 lg:justify-sta