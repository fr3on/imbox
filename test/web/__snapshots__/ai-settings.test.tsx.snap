exports[`AiSection > shows the form with its three steps until a provider works 1`] = `"<div class="mb-3 flex justify-end px-2"><button type="button" class="text-[13px] text-muted-foreground underline underline-offset-2 hover:text-foreground">Expand all</button></div><section class="mb-3 rounded-xl border border-border/80 bg-card"><button type="button" aria-expanded="true" class="flex w-full items-center justify-between gap-4 rounded-xl px-4 py-3.5 text-left outline-none focus-visible:ring-2 focus-visible:ring-ring sm:px-5"><h2 class="text-base font-semibold">AI</h2><span class="flex min-w-0 items-center gap-2 text-[13px] text-muted-foreground"><span class="truncate">Not set up</span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right shrink-0 transition-transform rotate-90" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></span></button><div class="border-t border-border/60"><div class="flex items-start justify-between gap-4 px-4 pt-3 sm:px-5"><p class="text-[13px] text-muted-foreground">Bring your own key. Mail is only sent to the provider when an AI feature runs.</p></div><ol class="mx-4 sm:mx-5 mb-3 list-inside list-decimal space-y-0.5 text-[13px] text-muted-foreground"><li>Choose a provider.</li><li>Add your key.</li><li>Pick a model, save, then test it.</li></ol><div><div class="grid sm:grid-cols-[minmax(0,1fr)_auto] gap-x-6 gap-y-3 items-center px-4 sm:px-5 py-3.5 border-b border-border/60 last:border-b-0 hover:bg-muted/15 transition-colors"><div class="min-w-0"><div class="min-w-0"><div class="text-sm font-medium text-foreground">Provider</div><div class="text-xs text-muted-foreground mt-0.5">Claude. https://api.anthropic.test</div></div></div><div class="min-w-0 sm:justify-self-end scrollbar-none"><div class="w-max max-w-full"><button data-slot="popover-trigger" data-variant="outline" dat