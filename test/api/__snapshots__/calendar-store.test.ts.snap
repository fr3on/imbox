exports[`the .ics export > exports an all-day event as dates 1`] = `
"BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//inbox//Calendar//EN
CALSCALE:GREGORIAN
X-WR-CALNAME:Cal 1
BEGIN:VEVENT
UID:<id>@inbox
DTSTAMP:<now>
DTSTART;VALUE=DATE:20261005
DTEND;VALUE=DATE:20261007
SUMMARY:Offsite
X-WR-TIMEZONE:UTC
STATUS:CONFIRMED
SEQUENCE:0
END:VEVENT
END:VCALENDAR
"
`;

exports[`the .ics export > exports one event with its guests and reminders 1`] = `
"BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//inbox//Calendar//EN
CALSCALE:GREGORIAN
X-WR-CALNAME:Cal 1
BEGIN:VEVENT
UID:<id>@inbox
DTSTAMP:<now>
DTSTART:20261005T090000Z
DTEND:20261005T100000Z
SUMMARY:Studio / review: Q4
DESCRIPTION:Bring cables
LOCATION:Room 2
URL:https://x.test/p
X-WR-TIMEZONE:UTC
STATUS:CONFIRMED
SEQUENCE:0
ATTENDEE;CN="Alex";ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;RSVP=TRUE:mai
 lto:a@x.test
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Studio / review: Q4
TRIGGER:-PT15M
END:VALARM
END:VEVENT
END:VCALENDAR
"
`;

