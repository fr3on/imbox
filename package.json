{
  "name": "imbox",
  "private": true,
  "version": "0.1.0",
  "description": "A calm, self-hosted email client with one owner.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "node scripts/pack-downloads.mjs && vite",
    "build": "node scripts/pack-downloads.mjs && vite build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.web-test.json --noEmit",
    "lint": "biome lint --max-diagnostics=50",
    "release:check": "node scripts/release.mjs check",
    "build:node": "npm run build && node scripts/build-node.mjs",
    "start:selfhost": "node server/run.mjs",
    "gen:schema": "node scripts/gen-schema.mjs",
    "inventory:sql": "node scripts/sql-inventory.mjs",
    "test:pg": "vitest run -c vitest.pg.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "ext:pack": "rm -f imbox-extension.zip && cd apps/extension && zip -qr ../../imbox-extension.zip . -x '*.DS_Store'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/query-sync-storage-persister": "^5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "hono": "^4.13.12",
    "lucide-react": "^1.49.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "postal-mime": "^4.0.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.11.2",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "shadcn": "^4.21.1",
    "@babel/parser": "^7.29.9",
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
