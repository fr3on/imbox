{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "picker",
  "description": "The bundled server picker page, never a remote page.",
  "windows": [
    "main"
  ],
  "permissions": [
    "notification:allow-is-permission-granted",
    "core:window:allow-start-dragging",
    "allow-probe-server",
    "allow-save-server",
    "allow-get-server", "allow-sign-in", "allow-sign-in-code", "allow-open-web-login"
  ]
}
