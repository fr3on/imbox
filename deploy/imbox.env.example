# /etc/imbox/imbox.env  (mode 600, owned by root; systemd reads it)
DATABASE_URL=postgres://imbox:CHANGE_ME@127.0.0.1:5432/imbox
APP_URL=https://imbox.example.com
APP_NAME=imbox
PORT=8787
HOST=127.0.0.1
# Encrypts what is stored encrypted: mailbox passwords, AI keys, OAuth client secrets, webhook secrets and the second-factor secret. Generate once:
# openssl rand -hex 32. Keep a copy somewhere other than this server. Changing it later makes everything stored under the old one unreadable.
SESSION_SECRET=CHANGE_ME
# Optional sign-in / integrations
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#MS_CLIENT_ID=
#MS_CLIENT_SECRET=
#RESEND_API_KEY=
